{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "../..",
    "declaration": false,
    "types": ["node"],
    "paths": {
      "@main/*": ["../../src/main/*"],
      "@/*": ["../../src/*"],
      "@constants": ["../../src/shared/constants"],
      "@types": ["../../src/shared/types"]
    }
  },
  "include": ["src/**/*", "../../src/main/**/*"]
}
