{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist/node",
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@main/*": ["./src/main/*"],
      "@constants": ["./src/shared/constants"],
      "@types": ["./src/shared/types"]
    }
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/shared/**/*", "electron.vite.config.ts"]
}
